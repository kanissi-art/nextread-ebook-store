<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= book.title %> - NEXTREAD</title>
    <style>
        :root {
            --bg-color: #f8fafc;
            --card-bg: #ffffff;
            --text-color: #0f172a;
            --text-sub: #64748b;
            --accent-color: #2563eb;
            --border-color: #e2e8f0;
        }

        body.dark-mode {
            --bg-color: #0b1120;
            --card-bg: #1e293b;
            --text-color: #f8fafc;
            --text-sub: #94a3b8;
            --accent-color: #3b82f6;
            --border-color: #334155;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 2rem;
            border-bottom: 1px solid var(--border-color);
            background-color: var(--card-bg);
        }

        .logo { font-size: 1.5rem; font-weight: bold; color: var(--accent-color); text-decoration: none; }

        .container { max-width: 900px; margin: 2rem auto; padding: 0 1rem; }

        .btn-back {
            display: inline-block;
            margin-bottom: 1.5rem;
            color: var(--text-sub);
            text-decoration: none;
            font-weight: 500;
        }
        .btn-back:hover { color: var(--accent-color); }

        .detail-card {
            background-color: var(--card-bg);
            border-radius: 12px;
            border: 1px solid var(--border-color);
            padding: 2rem;
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 2rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }

        @media (max-width: 640px) {
            .detail-card { grid-template-columns: 1fr; }
        }

        .book-cover {
            width: 100%;
            height: 380px;
            object-fit: cover;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .book-info { display: flex; flex-direction: column; }
        .book-category {
            display: inline-block;
            padding: 0.2rem 0.8rem;
            background-color: rgba(37, 99, 235, 0.1);
            color: var(--accent-color);
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: bold;
            width: fit-content;
            margin-bottom: 0.8rem;
        }

        .book-title { font-size: 1.8rem; margin: 0 0 0.5rem 0; line-height: 1.3; }
        .book-author { font-size: 1rem; color: var(--text-sub); margin-bottom: 1.5rem; }
        .book-price { font-size: 2rem; font-weight: bold; color: var(--accent-color); margin-bottom: 1.5rem; }

        .description-box {
            background-color: var(--bg-color);
            padding: 1rem;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            margin-bottom: 1.5rem;
            line-height: 1.6;
            color: var(--text-color);
            white-space: pre-line;
        }

        .btn-buy {
            background-color: var(--accent-color);
            color: white;
            padding: 0.8rem 1.5rem;
            border-radius: 8px;
            border: none;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            transition: opacity 0.2s;
        }

        .btn-buy:hover { opacity: 0.9; }
    </style>
</head>
<body>

    <header>
        <a href="/" class="logo">📖 NEXTREAD</a>
        <div style="display: flex; align-items: center; gap: 1rem;">
            <a href="/cart" style="background-color: var(--accent-color); color: white; padding: 0.5rem 1rem; border-radius: 20px; text-decoration: none; font-weight: bold; font-size: 0.9rem;">
                🛒 ตะกร้า (<%= cart.reduce((sum, item) => sum + item.quantity, 0) %>)
            </a>
            <a href="/admin" style="color: var(--text-color); text-decoration: none; font-size: 0.9rem;">⚙️ จัดการระบบ</a>
            <button onclick="toggleTheme()" style="background:transparent; border:1px solid var(--border-color); color:var(--text-color); padding:0.4rem 0.8rem; border-radius:20px; cursor:pointer;">🌙 / ☀️</button>
        </div>
    </header>

    <div class="container">
        <a href="/" class="btn-back">← กลับไปหน้าร้านค้า</a>

        <div class="detail-card">
            <div>
                <img src="<%= book.cover_image %>" class="book-cover" alt="<%= book.title %>">
            </div>
            <div class="book-info">
                <span class="book-category"><%= book.category %></span>
                <h1 class="book-title"><%= book.title %></h1>
                <div class="book-author">ผู้แต่ง: <%= book.author %></div>
                <div class="book-price">฿<%= book.price %></div>

                <h3>เรื่องย่อ / รายละเอียดหนังสือ</h3>
                <div class="description-box">
                    <%= book.description || 'ไม่มีรายละเอียดเรื่องย่อสำหรับหนังสือเล่มนี้' %>
                </div>

                <form action="/cart/add/<%= book.id %>" method="POST" style="margin-top: auto;">
                    <button type="submit" class="btn-buy">🛒 เพิ่มลงตะกร้าสินค้า</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        if (localStorage.getItem('theme') === 'dark') document.body.classList.add('dark-mode');
        function toggleTheme() {
            document.body.classList.toggle('dark-mode');
            localStorage.setItem('theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light');
        }
    </script>
</body>
</html>